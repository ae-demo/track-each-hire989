  "description": "Staff-facing single-page app for HR, IT and Facilities. HR adds new hires, maintains the checklist template, adds one-off tasks, and sees overdue items and cross-department status; IT and Facilities each work their own task queue. Holds no business data of its own — everything comes from onboarding-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "onboarding-api",
      "description": "Calls the onboarding API for new hires, the checklist template, and department task queues.",
      "wiring": {
        "endpoint": {
          "component": "track-each-hire989-onboarding-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "ONBOARDING_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "track-each-hire98-210fb728",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
